# Variables de entorno del contenedor de desarrollo de Tamalio.
#
# Es la única fuente de estos valores. Las usan:
#   - compose.yaml (env_file), para los procesos que lanza Docker
#     (VS Code y Zed en contenedor local);
#   - /etc/profile.d/tamalio.sh, que genera post-create.sh, para las sesiones
#     SSH (Zed conectado a Codespaces), que no heredan el entorno de Docker.
#
# Formato KEY=valor, sin comillas ni espacios, para que lo entiendan tanto
# Docker Compose como el shell.
#
# Aquí no hay contraseñas. PGPASSWORD, TAMALIO_BD_URL y TAMALIO_BD_PRUEBAS los
# añade post-create.sh a /etc/profile.d/tamalio.sh con la contraseña aleatoria
# que genera el servicio «db».

# Valores predeterminados de libpq y psycopg.
PGHOST=localhost
PGPORT=5432
PGUSER=tamalio
PGDATABASE=tamalio

# La caché de uv y el proyecto están en sistemas de ficheros distintos.
UV_LINK_MODE=copy

LANG=C.UTF-8
TZ=America/Mexico_City
