# =====================================================================
# Tamalio · Variables de entorno opcionales
# ---------------------------------------------------------------------
# Copia este fichero como «.env» (está ignorado por Git) y cárgalo en tu
# terminal, por ejemplo:  set -a; source .env; set +a
# Tienen prioridad sobre tamalio.toml.
# =====================================================================

# Conexión a PostgreSQL. Obligatoria si no defines [base_datos] url en
# tamalio.toml. Usa tu propia contraseña: no hay ninguna predeterminada y
# «tamalio» se rechaza. También puedes quitarla de la URL y usar PGPASSWORD.
TAMALIO_BD_URL=postgresql://tamalio:TU_CONTRASEÑA@localhost:5432/tamalio

# Carpeta de música alternativa (por defecto ~/Música o ~/Music en Windows).
# TAMALIO_DESTINO=/mnt/disco/Música

# Nombre de la subcarpeta del usuario.
# TAMALIO_USUARIO=quetzal

# Fichero de configuración alternativo.
# TAMALIO_CONFIG=/ruta/a/tamalio.toml

# Base de datos DESECHABLE para las pruebas de integración (se vacía).
# TAMALIO_BD_PRUEBAS=postgresql://tamalio:TU_CONTRASEÑA@localhost:5432/tamalio_pruebas

# Desactiva los colores en la terminal (https://no-color.org).
# NO_COLOR=1

# Modo depuración (igual que --debug).
# TAMALIO_DEBUG=1
